void handleDesbloquear() {
  if (server.hasArg("id")) {
    String id = server.arg("id");
    id.toUpperCase();
    desbloquearCracha(id);
    server.send(200, "text/plain", "Cracha desbloqueado: " + id);
  } else {
    server.send(400, "text/plain", "ID nao fornecido");
  }
}

void handleSimularRFID() {
  if (server.hasArg("id")) {
    String id = server.arg("id");
    id.toUpperCase();
    
    Serial.print("RFID SIMULADO VIA WEB: ");
    Serial.println(id);
    
    bool valido = false;
    String nomeEncontrado = "";
    for (int i = 0; i < numOperadores; i++) {
      if (operadores[i].id == id) {
        nomeEncontrado = operadores[i].nome;
        valido = true;
        break;
      }
    }
    
    if (valido) {
      iniciarLeituraSimulada(id, nomeEncontrado);
      server.send(200, "text/plain", "OK: " + id + " - " + nomeEncontrado);
    } else {
      server.send(400, "text/plain", "ERRO: ID nao encontrado - " + id);
    }
  } else {
    server.send(400, "text/plain", "ERRO: Parametro 'id' nao fornecido");
  }
}

void handleEmergency() {
  String action = server.arg("action");
  if (action == "trigger") {
    estadoAtual = EMERGENCIA_COMPROMETIDA;
    server.send(200, "text/plain", "EMERGENCIA");
  } else if (action == "reset") {
    estadoAtual = STANDBY_ENERGIZADO;
    idOperadorAtual = "";
    nomeOperadorAtual = "";
    temperaturaAtual = 0;
    batimentosAtual = 0;
    for (int i = 0; i < 10; i++) historicoBPM[i] = 0;
    indiceGrafico = 0;
    leituraTempValida = false;
    leituraBPMValida = false;
    acessoLiberado = false;
    tentativasInstaveis = 0;
    aguardandoModoEstavel = false;
    MODO_TEMP_INSTAVEL = false;
    server.send(200, "text/plain", "RESETADO");
  }
}

void inicializarServidorWeb() {
  server.on("/", handleRoot);
  server.on("/status", handleStatus);
  server.on("/operadores", handleOperadores);
  server.on("/desbloquear", handleDesbloquear);
  server.on("/simular_rfid", handleSimularRFID);
  server.on("/emergencia", handleEmergency);
  server.begin();
  Serial.println("Servidor Web iniciado!");
}

