bool buscarEValidarOperador(String id) {
  id.toUpperCase();
  
  for (int i = 0; i < numCrachasBloqueados; i++) {
    if (crachasBloqueados[i].id == id && crachasBloqueados[i].bloqueado) {
      if (millis() - crachasBloqueados[i].tempoBloqueio > TEMPO_BLOQUEIO) {
        crachasBloqueados[i].bloqueado = false;
        Serial.println("Cracha desbloqueado automaticamente: " + id);
      } else {
        Serial.println("Cracha BLOQUEADO temporariamente: " + id);
        return false;
      }
    }
  }
  
  for (int i = 0; i < numOperadores; i++) {
    if (operadores[i].id == id) {
      if (operadores[i].status == "Ativo" && !operadores[i].bloqueado) {
        nomeOperadorAtual = operadores[i].nome;
        Serial.println("Operador ATIVO: " + nomeOperadorAtual);
        return true;
      } else if (operadores[i].bloqueado) {
        Serial.println("Operador BLOQUEADO pela gerencia: " + operadores[i].nome);
        return false;
      } else {
        Serial.println("Operador INATIVO: " + operadores[i].nome);
        return false;
      }
    }
  }
  
  Serial.println("ID NAO encontrado!");
  return false;
}

void bloquearCracha(String id, String nome) {
  for (int i = 0; i < numCrachasBloqueados; i++) {
    if (crachasBloqueados[i].id == id) {
      crachasBloqueados[i].bloqueado = true;
      crachasBloqueados[i].tempoBloqueio = millis();
      Serial.println("Cracha BLOQUEADO: " + id + " - " + nome);
      return;
    }
  }
  
  if (numCrachasBloqueados < 10) {
    crachasBloqueados[numCrachasBloqueados].id = id;
    crachasBloqueados[numCrachasBloqueados].nome = nome;
    crachasBloqueados[numCrachasBloqueados].bloqueado = true;
    crachasBloqueados[numCrachasBloqueados].tempoBloqueio = millis();
    numCrachasBloqueados++;
    Serial.println("Cracha BLOQUEADO: " + id + " - " + nome);
  }
}

void desbloquearCracha(String id) {
  for (int i = 0; i < numCrachasBloqueados; i++) {
    if (crachasBloqueados[i].id == id) {
      crachasBloqueados[i].bloqueado = false;
      Serial.println("Cracha DESBLOQUEADO: " + id);
      return;
    }
  }
}

String listarCrachasBloqueados() {
