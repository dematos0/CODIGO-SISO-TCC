void atualizarPainelHMI(bool vermelho, bool amarelo, bool verde) {
  digitalWrite(RELE_VERMELHO, vermelho ? HIGH : LOW);
  digitalWrite(RELE_AMARELO, amarelo ? HIGH : LOW);
  digitalWrite(RELE_VERDE, verde ? HIGH : LOW);
}

String obterIDRFID() {
  if (millis() - ultimaLeituraRFID < INTERVALO_RFID) return "";
  ultimaLeituraRFID = millis();
  
  if (!rfid.PICC_IsNewCardPresent()) return "";
  if (!rfid.PICC_ReadCardSerial()) return "";
  
  String id = "";
  for (byte i = 0; i < rfid.uid.size; i++) {
    id += String(rfid.uid.uidByte[i] < 0x10 ? "0" : "");
    id += String(rfid.uid.uidByte[i], HEX);
  }
  id.toUpperCase();
  
  rfid.PICC_HaltA();
  rfid.PCD_StopCrypto1();
  
  if (id == ultimoIDLido && (millis() - tempoUltimoID) < TEMPO_IGNORAR_MESMO_ID) {
    return "";
  }
  
  ultimoIDLido = id;
  tempoUltimoID = millis();
  
  Serial.print("RFID: ");
  Serial.println(id);
  
  return id;
}

bool verificarEstabilidadeTemp(float novaTemp) {
  bufferTemp[idxTemp] = novaTemp;
  idxTemp = (idxTemp + 1) % 5;
  if (contadorTemp < 5) contadorTemp++;
  
  if (contadorTemp < 3) return false;
  
  float soma = 0;
  for (int i = 0; i < contadorTemp; i++) {
    soma += bufferTemp[i];
  }
  float media = soma / contadorTemp;
  
  bool estavel = true;
  for (int i = 0; i < contadorTemp; i++) {
    if (abs(bufferTemp[i] - media) > 1.0) {
      estavel = false;
      break;
    }
  }
  
  if (estavel && media > 33 && media < 38) {
    temperaturaAtual = media;
    return true;
  }
  return false;
}

bool verificarEstabilidadeBPM(int novoBPM) {
  bufferBPM[idxBPM] = novoBPM;
  idxBPM = (idxBPM + 1) % 5;
  if (contadorBPM < 5) contadorBPM++;
  
  if (contadorBPM < 3) return false;
  
  int soma = 0;
  for (int i = 0; i < contadorBPM; i++) {
    soma += bufferBPM[i];
  }
  int media = soma / contadorBPM;
  
  bool estavel = true;
  for (int i = 0; i < contadorBPM; i++) {
    if (abs(bufferBPM[i] - media) > 20) {
      estavel = false;
      break;
    }
  }
  
  if (estavel && media > 40 && media < 180) {
    batimentosAtual = media;
    return true;
  }
  return false;
}

void atualizarValoresEstaveis() {
  if (millis() - ultimaVariacaoEstavel < INTERVALO_VARIACAO) return;
  ultimaVariacaoEstavel = millis();
  
  float tempNova = tempBase + ((random(-800, 801)) / 1000.0);
  if (tempNova < 35.5) tempNova = 35.5;
  if (tempNova > 37.3) tempNova = 37.3;
  tempForcada = tempNova;
  
  int bpmNovo = bpmBase + random(-bpmVariacao, bpmVariacao + 1);
  if (bpmNovo < 60) bpmNovo = 60;
  if (bpmNovo > 95) bpmNovo = 95;
  bpmForcado = bpmNovo;
  
  temperaturaAtual = tempForcada;
  batimentosAtual = bpmForcado;
  
  if (indiceGrafico < 10) {
    historicoBPM[indiceGrafico] = bpmForcado;
    indiceGrafico++;
  } else {
    for (int i = 0; i < 9; i++) {
      historicoBPM[i] = historicoBPM[i + 1];
    }
    historicoBPM[9] = bpmForcado;
  }
}

// =================================================================================
// FUNCAO DE LEITURA DA TEMPERATURA (COM MODO INSTAVEL)
// =================================================================================
float lerTemperatura() {
  // MODO TEMPERATURA INSTAVEL - Forca valores altos (acima do limite)
  if (MODO_TEMP_INSTAVEL) {
    float tempNova = 38.0 + ((random(0, 150)) / 100.0);  // 38.0 a 39.5C
    tempInstavel = tempNova;
    temperaturaAtual = tempInstavel;
    
    // Nao marca como valida (para forcar bloqueio)
    leituraTempValida = false;
    
    static unsigned long ultimoPrint = 0;
    if (millis() - ultimoPrint > 500) {
      ultimoPrint = millis();
      Serial.print("Temp INSTAVEL: ");
      Serial.print(temperaturaAtual, 1);
      Serial.println("C (acima do limite!)");
    }
    
    return tempInstavel;
  }
  
  if (MODO_ESTAVEL) {
    atualizarValoresEstaveis();
    leituraTempValida = true;
    return temperaturaAtual;
  }
  
  float temp = mlx.readObjectTempC();
  
  if (!isnan(temp) && temp > 30 && temp < 50) {
    if (verificarEstabilidadeTemp(temp)) {
      leituraTempValida = true;
      static bool jaMostrou = false;
      if (!jaMostrou) {
        Serial.print("Temp ESTAVEL: ");
        Serial.print(temperaturaAtual);
        Serial.println("C");
        jaMostrou = true;
      }
    }
    return temp;
  }
  return 0;
}

int lerBatimentos() {
  if (MODO_ESTAVEL) {
    atualizarValoresEstaveis();
    leituraBPMValida = true;
    return batimentosAtual;
  }
  
  irValue = particleSensor.getIR();
  
  if (irValue < 20000) return batimentosAtual;
  
  static long ultimoValor = 0;
  static long picoMaximo = 0;
  static long valeMinimo = 999999;
  static bool subindo = false;
  static unsigned long ultimoPico = 0;
  static int picosDetectados = 0;
  
  if (irValue > ultimoValor && irValue > picoMaximo) {
    picoMaximo = irValue;
    subindo = true;
  }
  
  if (irValue < ultimoValor && subindo && (picoMaximo - valeMinimo > 2000)) {
    unsigned long agora = millis();
    
    if (ultimoPico > 0) {
      unsigned long intervalo = agora - ultimoPico;
      
      if (intervalo > 300 && intervalo < 2000) {
        int bpm = 60000 / intervalo;
        
        if (bpm > 30 && bpm < 200) {
          picosDetectados++;
          
          if (batimentosAtual == 0 || batimentosAtual > 100) {
            batimentosAtual = bpm;
          } else {
            batimentosAtual = (int)((batimentosAtual * 0.7) + (bpm * 0.3));
          }
          
          if (indiceGrafico < 10) {
            historicoBPM[indiceGrafico] = batimentosAtual;
            indiceGrafico++;
          } else {
            for (int i = 0; i < 9; i++) {
              historicoBPM[i] = historicoBPM[i + 1];
            }
            historicoBPM[9] = batimentosAtual;
          }
          
          static int contador = 0;
          contador++;
          if (contador % 3 == 0) {
            Serial.print("BPM: ");
            Serial.print(batimentosAtual);
            Serial.print(" | IR: ");
            Serial.println(irValue);
          }
          
          if (picosDetectados >= 3) {
            if (verificarEstabilidadeBPM(batimentosAtual)) {
              leituraBPMValida = true;
            }
          }
        }
      }
    }
    
    ultimoPico = agora;
    valeMinimo = irValue;
    subindo = false;
    picoMaximo = 0;
  }
  
  if (irValue < ultimoValor && irValue < valeMinimo) {
    valeMinimo = irValue;
  }
  
  ultimoValor = irValue;
  return batimentosAtual;
}

bool podeLiberarAcesso() {
  if (!leituraTempValida) return false;
  if (!leituraBPMValida) return false;
  if (temperaturaAtual < 33.0 || temperaturaAtual > 42.0) return false;
  if (temperaturaAtual >= 37.8) return false;
  if (batimentosAtual < 40 || batimentosAtual > 180) return false;
  return true;
}

