// =================================================================================
// LOOP PRINCIPAL
// =================================================================================
void loop() {
  server.handleClient();
  processarComandosSerial();
  
  if (digitalRead(PINO_EMERGENCIA) == HIGH && estadoAtual != EMERGENCIA_COMPROMETIDA) {
    estadoAtual = EMERGENCIA_COMPROMETIDA;
    Serial.println("EMERGENCIA ACIONADA PELO BOTAO!");
    atualizarPainelHMI(true, false, false);
  }
  
  String idDetectado = obterIDRFID();
  
  switch (estadoAtual) {
    
    case EMERGENCIA_COMPROMETIDA:
      atualizarPainelHMI(true, false, false);
      if (digitalRead(PINO_EMERGENCIA) == LOW) {
        estadoAtual = STANDBY_ENERGIZADO;
        acessoLiberado = false;
        tentativasInstaveis = 0;
        Serial.println("Emergencia resetada");
        atualizarPainelHMI(true, false, false);
      }
      break;
    
    case STANDBY_ENERGIZADO:
      atualizarPainelHMI(true, false, false);
      if (idDetectado != "" && buscarEValidarOperador(idDetectado)) {
        idOperadorAtual = idDetectado;
        tempoTransicao = millis();
        indiceGrafico = 0;
        temperaturaAtual = 0;
        batimentosAtual = 0;
        leituraTempValida = false;
        leituraBPMValida = false;
        acessoLiberado = false;
        tentativasInstaveis = 0;
        contadorTemp = 0;
        contadorBPM = 0;
        estadoAtual = LEITURA_EM_ANDAMENTO;
        
        if (MODO_ESTAVEL) {
          tempoInicioLeituraEstavel = millis();
          aguardandoModoEstavel = true;
          ultimaVariacaoEstavel = 0;
        }
        
        Serial.println("\nIniciando leitura...");
        if (MODO_TEMP_INSTAVEL) {
          Serial.println("   MODO TEMP INSTAVEL ativo - cracha sera bloqueado!");
        } else {
          Serial.println("   Coloque o dedo no MAX30102");
          Serial.println("   Aponte o MLX90614 para a testa");
        }
      }
      break;
    
    case LEITURA_EM_ANDAMENTO: {
      atualizarPainelHMI(false, true, false);
      
      float temp = lerTemperatura();
      if (temp > 30 && temp < 50) temperaturaAtual = temp;
      
      int bpm = lerBatimentos();
      if (bpm > 0) batimentosAtual = bpm;
      
      // ============================================================
      // MODO TEMPERATURA INSTAVEL - BLOQUEIO RAPIDO GARANTIDO
      // ============================================================
      if (MODO_TEMP_INSTAVEL) {
        tentativasInstaveis++;
        
        // Mostra progresso
        if (tentativasInstaveis % 5 == 0) {
          Serial.print("TEMP INSTAVEL - Tentativa ");
          Serial.print(tentativasInstaveis);
          Serial.print(" de ");
          Serial.println(MAX_TENTATIVAS_INSTAVEIS);
        }
        
        // Bloqueia apos atingir o maximo
        if (tentativasInstaveis >= MAX_TENTATIVAS_INSTAVEIS) {
          Serial.println("\n========================================");
          Serial.println("   BLOQUEANDO CRACHA POR TEMP INSTAVEL");
          Serial.println("========================================");
          
          bloquearCracha(idOperadorAtual, nomeOperadorAtual);
          totalBloqueiosSaude++;
          
          Serial.println("CRACHA BLOQUEADO: " + idOperadorAtual);
          Serial.println("Bloqueios por saude totais: " + String(totalBloqueiosSaude));
          
          // Limpa estado
          idOperadorAtual = "";
          nomeOperadorAtual = "";
          temperaturaAtual = 0;
          batimentosAtual = 0;
          leituraTempValida = false;
          leituraBPMValida = false;
          tentativasInstaveis = 0;
          MODO_TEMP_INSTAVEL = false;
          estadoAtual = STANDBY_ENERGIZADO;
          atualizarPainelHMI(true, false, false);
          
          break;
        }
        
        break;
      }
      
      // ============================================================
      // MODO ESTAVEL - Aguarda 10 segundos
      // ============================================================
      if (MODO_ESTAVEL && aguardandoModoEstavel) {
        unsigned long tempoDecorrido = millis() - tempoInicioLeituraEstavel;
        
        static unsigned long ultimoPrintEstavel = 0;
        if (millis() - ultimoPrintEstavel > 1000) {
          ultimoPrintEstavel = millis();
          int segundosRestantes = (DELAY_MODO_ESTAVEL - tempoDecorrido) / 1000;
          if (segundosRestantes > 0) {
            Serial.print("Processando leitura... ");
            Serial.print(segundosRestantes);
            Serial.print("s restantes | Temp: ");
            Serial.print(temperaturaAtual, 1);
            Serial.print("C | BPM: ");
            Serial.print(batimentosAtual);
            Serial.println(" BPM");
          }
        }
        
        if (tempoDecorrido >= DELAY_MODO_ESTAVEL) {
          aguardandoModoEstavel = false;
          
          if (podeLiberarAcesso()) {
            acessoLiberado = true;
            totalAcessosLiberados++;
            estadoAtual = LEITURA_APROVADA;
            Serial.println("\nACESSO LIBERADO!");
            Serial.print("   Temp: "); Serial.print(temperaturaAtual, 1); Serial.println("C");
            Serial.print("   BPM: "); Serial.print(batimentosAtual); Serial.println(" BPM");
            atualizarPainelHMI(false, false, true);
            tentativasInstaveis = 0;
          } else {
            totalBloqueiosSaude++;
            Serial.println("\nACESSO BLOQUEADO!");
            idOperadorAtual = "";
            nomeOperadorAtual = "";
            temperaturaAtual = 0;
            batimentosAtual = 0;
            leituraTempValida = false;
            leituraBPMValida = false;
            tentativasInstaveis = 0;
            estadoAtual = STANDBY_ENERGIZADO;
            atualizarPainelHMI(true, false, false);
          }
        }
        break;
      }
      
      // ============================================================
      // MODO NORMAL
      // ============================================================
      if (leituraTempValida && leituraBPMValida && !acessoLiberado) {
        if (podeLiberarAcesso()) {
          acessoLiberado = true;
          totalAcessosLiberados++;
          estadoAtual = LEITURA_APROVADA;
          Serial.println("\nACESSO LIBERADO!");
          Serial.print("   Temp: "); Serial.print(temperaturaAtual); Serial.println("C");
          Serial.print("   BPM: "); Serial.print(batimentosAtual); Serial.println(" BPM");
          atualizarPainelHMI(false, false, true);
          tentativasInstaveis = 0;
        }
      }
      
      unsigned long tempoDecorrido = millis() - tempoTransicao;
      
      if (tempoDecorrido > 20000 && idOperadorAtual != "") {
        bool realmenteInstavel = false;
        
        if (!leituraTempValida && contadorTemp >= 3) realmenteInstavel = true;
        if (!leituraBPMValida && contadorBPM >= 3) realmenteInstavel = true;
        
        if (leituraTempValida && leituraBPMValida) {
          tentativasInstaveis = 0;
          realmenteInstavel = false;
        }
        
        if (realmenteInstavel) {
          tentativasInstaveis++;
          
          if (tentativasInstaveis % 3 == 0) {
            Serial.print("Medicoes INSTAVEIS - Tentativa ");
            Serial.print(tentativasInstaveis);
            Serial.print(" de ");
            Serial.println(MAX_TENTATIVAS_INSTAVEIS);
          }
          
          if (tentativasInstaveis >= MAX_TENTATIVAS_INSTAVEIS) {
            bloquearCracha(idOperadorAtual, nomeOperadorAtual);
            Serial.println("CRACHA BLOQUEADO POR INSTABILIDADE!");
            
            idOperadorAtual = "";
            nomeOperadorAtual = "";
            temperaturaAtual = 0;
            batimentosAtual = 0;
            leituraTempValida = false;
            leituraBPMValida = false;
            tentativasInstaveis = 0;
            estadoAtual = STANDBY_ENERGIZADO;
            atualizarPainelHMI(true, false, false);
          }
        } else {
          if (tentativasInstaveis > 0) tentativasInstaveis = 0;
        }
      }
      
      if (millis() - tempoTransicao > TIMEOUT_LEITURA && !acessoLiberado) {
        Serial.println("\nTIMEOUT!");
        
        if (tentativasInstaveis > 5 && idOperadorAtual != "") {
          bloquearCracha(idOperadorAtual, nomeOperadorAtual);
          Serial.println("CRACHA BLOQUEADO POR TIMEOUT COM INSTABILIDADE!");
        } else {
          Serial.println("   Tempo esgotado - nenhum bloqueio aplicado");
        }
        
        idOperadorAtual = "";
        nomeOperadorAtual = "";
        temperaturaAtual = 0;
        batimentosAtual = 0;
        leituraTempValida = false;
        leituraBPMValida = false;
        tentativasInstaveis = 0;
        estadoAtual = STANDBY_ENERGIZADO;
        atualizarPainelHMI(true, false, false);
      }
      break;
    }
    
    case LEITURA_APROVADA:
      atualizarPainelHMI(false, false, true);
      if (idDetectado != "" && idDetectado == idOperadorAtual) {
        idOperadorAtual = "";
        nomeOperadorAtual = "";
        temperaturaAtual = 0;
        batimentosAtual = 0;
        leituraTempValida = false;
        leituraBPMValida = false;
        acessoLiberado = false;
        tentativasInstaveis = 0;
        estadoAtual = STANDBY_ENERGIZADO;
        Serial.println("Operador finalizou acesso");
        atualizarPainelHMI(true, false, false);
      }
      break;
  }
  
  delay(50);
}
