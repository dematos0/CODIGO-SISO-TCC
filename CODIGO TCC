const STATE_STANDBY=0, STATE_READING=1, STATE_APPROVED=2, STATE_EMERGENCY=3;
const SENHA_GERENCIA = "admin123";
let logadoGerencia = false;

function showTab(tab) {
    document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.tab').forEach(el => el.classList.remove('active'));
    document.getElementById('tab-' + tab).classList.add('active');
    document.querySelector(`.tab[onclick="showTab('${tab}')"]`).classList.add('active');
}

function simularRFID(id) {
    fetch('/simular_rfid?id=' + id)
        .then(r => r.text())
        .then(resposta => { console.log('Simulacao RFID:', resposta); updateData(); })
        .catch(err => console.log('Erro:', err));
}

function loginGerencia() {
    const senha = document.getElementById('senhaGerencia').value;
    if (senha === SENHA_GERENCIA) {
        document.getElementById('gerenciaLogin').style.display = 'none';
        document.getElementById('gerenciaContent').style.display = 'block';
        document.getElementById('erroSenha').style.display = 'none';
        logadoGerencia = true;
        updateGerenciaData();
    } else {
        document.getElementById('erroSenha').style.display = 'block';
        setTimeout(() => document.getElementById('erroSenha').style.display = 'none', 3000);
    }
}

function logoutGerencia() {
    document.getElementById('gerenciaLogin').style.display = 'block';
    document.getElementById('gerenciaContent').style.display = 'none';
    document.getElementById('senhaGerencia').value = '';
    logadoGerencia = false;
}

function desbloquearCracha(id) {
    fetch('/desbloquear?id=' + id)
        .then(() => { updateGerenciaData(); updateData(); })
        .catch(err => console.log('Erro:', err));
}

function triggerEmergency() {
    if (confirm('Acionar EMERGENCIA?')) {
        fetch('/emergencia?action=trigger')
            .then(() => document.getElementById('emergencyOverlay').classList.add('show'));
    }
}

function resetEmergency() {
    fetch('/emergencia?action=reset')
        .then(() => document.getElementById('emergencyOverlay').classList.remove('show'));
}

function resetSystem() {
    if (confirm('Resetar sistema?')) {
        fetch('/emergencia?action=reset').then(() => location.reload());
    }
}

function updateLEDs(state) {
    const r = document.getElementById('ledRed');
    const y = document.getElementById('ledYellow');
    const g = document.getElementById('ledGreen');
    r.className = 'led led-off'; y.className = 'led led-off'; g.className = 'led led-off';
    if (state === STATE_STANDBY || state === STATE_EMERGENCY) r.className = 'led led-on-red';
    else if (state === STATE_READING) y.className = 'led led-on-yellow';
    else if (state === STATE_APPROVED) g.className = 'led led-on-green';
}

function setStatus(state) {
    const el = document.getElementById('sysStatus');
    const icon = document.getElementById('sysIcon');
    if (state === STATE_STANDBY) { el.textContent = 'STANDBY'; el.style.color = '#ffcc00'; icon.textContent = '\u25CF'; icon.style.color = '#ffcc00'; }
    else if (state === STATE_READING) { el.textContent = 'VALIDANDO'; el.style.color = '#1590ff'; icon.textContent = '\u25C9'; icon.style.color = '#1590ff'; }
    else if (state === STATE_APPROVED) { el.textContent = 'LIBERADO'; el.style.color = '#32e04d'; icon.textContent = '\u2713'; icon.style.color = '#32e04d'; }
    else if (state === STATE_EMERGENCY) { el.textContent = 'EMERGENCIA'; el.style.color = '#ff0000'; icon.textContent = '!'; icon.style.color = '#ff0000'; }
    updateLEDs(state);
}

function updateChart(values) {
    const container = document.getElementById('chartBars');
    const maxVal = Math.max(150, ...values);
    let html = '';
    values.forEach(v => {
        const pct = maxVal > 0 ? (v / maxVal) * 100 : 0;
        const h = Math.max(5, pct * 1.2);
        html += `<div class="bar" style="height:${h}%;background:${v > 100 ? '#ff6b6b' : '#4ecdc4'}">
            <span class="bar-value">${v || 0}</span>
        </div>`;
    });
    container.innerHTML = html;
}

function updateFuncionariosList(operadores) {
    const tbody = document.getElementById('funcionariosList');
    let html = '';
    operadores.forEach(op => {
        const statusClass = op.status === 'Ativo' ? 'status-ativo' : 'status-bloqueado';
        const badgeClass = op.bloqueado ? 'badge-red' : 'badge-green';
        const badgeText = op.bloqueado ? 'BLOQUEADO' : 'ATIVO';
        html += `<tr style="border-bottom:1px solid #1a2530">
            <td style="padding:12px 10px;color:#1590ff;font-weight:bold">${op.id}</td>
            <td style="padding:12px 10px">${op.nome}</td>
            <td style="padding:12px 10px"><span class="operator-status ${statusClass}">${op.status}</span></td>
            <td style="padding:12px 10px"><span class="badge ${badgeClass}">${badgeText}</span></td>
        </tr>`;
    });
    tbody.innerHTML = html;
}

function updateCrachasBloqueados(lista) {
    const container = document.getElementById('crachasBloqueadosList');
    if (!lista || lista === 'Nenhum cracha bloqueado') {
        container.innerHTML = 'Nenhum cracha bloqueado';
        return;
    }
    let html = '';
    const items = lista.split('\n');
    items.forEach(item => {
        if (item.trim()) {
            const parts = item.split(' - ');
            if (parts.length === 2) {
                html += `<div class="cracha-item"><span><span class="id">${parts[0]}</span> - <span class="nome">${parts[1]}</span></span></div>`;
            }
        }
    });
    container.innerHTML = html || 'Nenhum cracha bloqueado';
}

function updateGerenciaData() {
    if (!logadoGerencia) return;
    fetch('/status')
        .then(r => r.json())
        .then(d => {
            document.getElementById('gerenciaLibCount').textContent = d.liberados || 0;
            document.getElementById('gerenciaBlkCount').textContent = d.bloqueados || 0;
            const container = document.getElementById('crachasParaDesbloquear');
            const lista = d.crachasBloqueados || 'Nenhum cracha bloqueado';
            if (lista === 'Nenhum cracha bloqueado') {
                container.innerHTML = '<p style="color:#32e04d">Nenhum cracha bloqueado</p>';
            } else {
                let html = '';
                const items = lista.split('\n');
                items.forEach(item => {
                    if (item.trim()) {
                        const parts = item.split(' - ');
                        if (parts.length === 2) {
                            html += `<div class="cracha-item">
                                <span><span class="id">${parts[0]}</span> - <span class="nome">${parts[1]}</span></span>
                                <button class="btn btn-success" style="padding:5px 15px;font-size:12px" onclick="desbloquearCracha('${parts[0]}')">Desbloquear</button>
                            </div>`;
                        }
                    }
                });
                container.innerHTML = html;
            }
            document.getElementById('gerenciaBlockedCount').textContent = lista === 'Nenhum cracha bloqueado' ? 0 : items.length;
        });
}

function updateData() {
    fetch('/status')
        .then(r => r.json())
        .then(d => {
            setStatus(Number(d.estado));
            
            if (d.id && d.id !== '') {
                document.getElementById('opName').textContent = d.operador || 'Operador';
                document.getElementById('opID').textContent = 'ID: ' + d.id;
                document.getElementById('opStatus').textContent = 'ATIVO';
                document.getElementById('opStatus').className = 'operator-status status-ativo';
                document.getElementById('eventRFID').innerHTML = 'RFID: ' + d.id;
            } else {
