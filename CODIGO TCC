void handleStatus() {
  String json = obterJsonStatus();
  
  StaticJsonDocument<2048> doc;
  deserializeJson(doc, json);
  
  JsonArray operadoresArray = doc.createNestedArray("operadores");
  for (int i = 0; i < numOperadores; i++) {
    JsonObject op = operadoresArray.createNestedObject();
    op["id"] = operadores[i].id;
    op["nome"] = operadores[i].nome;
    op["status"] = operadores[i].status;
    op["bloqueado"] = operadores[i].bloqueado;
  }
  
  doc["crachasBloqueados"] = listarCrachasBloqueados();
  
  String resposta;
  serializeJson(doc, resposta);
  server.send(200, "application/json", resposta);
}

